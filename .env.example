# Daily Wrap — local dev.
#
# You probably don't need this file. `bun run dev` (scripts/dev.ts) already
# loads secrets from ~/.ast/project-configs.json and takes a live GitHub token
# from `gh auth token`. Copy this only if you'd rather be explicit.
#
# In production none of it is needed: Astropods prompts for each value declared
# in astropods.yml (`agent.inputs`) and injects the rest from the `models`,
# `integrations` and `knowledge` blocks.

# Writes the wraps. Astropods prompts for this at deploy time via the
# `models.anthropic` entry.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Commits, PRs and reviews. Needs `repo` + `read:user` so private repos count.
# Injected by the `integrations.github` entry in production.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=sohumdalal

# Where one day ends and the next begins.
TIMEZONE=America/New_York

# Claude Code home to read. Defaults to ~/.claude.
# CLAUDE_HOME=/Users/you/.claude

# Postgres. Injected by the `knowledge.daily-wrap-db` entry in production.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daily_wrap
POSTGRES_USER=
POSTGRES_PASSWORD=

# Server. 3002 locally; the deployed container must bind 80.
PORT=3002
