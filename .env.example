# Mentor — local dev env (also see scripts/dev.ts which auto-loads
# from ~/.ast/project-configs.json if present).
#
# In production these are set via the Astropods setup UI (see astropods.yml
# `agent.inputs`) — you don't need a .env at all on the deployed agent.

# Required for GitHub PR / activity ingestion. Needs `repo` + `read:user`
# scopes (private repos count toward your weekly PR totals).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=sohumdalal

# LLM provider — at least one of these must be set to generate weekly reviews.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default provider + models (override per-request from the UI).
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o

# Postgres — local dev defaults match Homebrew's PostgreSQL 16 install.
# On Astropods these come from the `mentor-db` knowledge declaration.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mentor
POSTGRES_USER=
POSTGRES_PASSWORD=

# Server
PORT=3002
APP_URL=http://localhost:5173
