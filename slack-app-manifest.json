{
  "display_information": {
    "name": "Daily Wrap",
    "description": "React with the brain emoji to keep a message as feedback in your daily wrap.",
    "background_color": "#181818"
  },
  "features": {
    "bot_user": {
      "display_name": "Daily Wrap",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "reactions:read",
        "reactions:write",
        "channels:history",
        "groups:history",
        "chat:write",
        "im:history",
        "app_mentions:read",
        "channels:read",
        "groups:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "reaction_added",
        "app_mention",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
